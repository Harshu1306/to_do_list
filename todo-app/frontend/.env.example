# Backend API URL — pick ONE of the two options below.

# Option A (recommended, no backend CORS change needed):
# Leave NEXT_PUBLIC_API_URL empty/unset. The browser calls the same-origin
# "/api" path and Next.js proxies it to API_PROXY_URL (next.confi
API_PROXY_URL="https://todolist-chi-eight-90.vercel.app/api"

# Option B (direct calls): set the backend URL explicitly.
# The FastAPI backend must then allow this frontend origin in CORS.
# NEXT_PUBLIC_API_URL=http://localhost:8000
