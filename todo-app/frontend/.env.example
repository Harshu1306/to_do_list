# Backend API proxy target for LOCAL development only (server-side, not
# NEXT_PUBLIC_*). The browser always calls the same-origin "/api" path
# (see lib/api.ts); Next.js rewrites /api/:path* to API_PROXY_URL/:path*.
#
# Local development: FastAPI runs at http://localhost:8000 (no /api suffix,
# because /api is already stripped by the Next.js rewrite).
API_PROXY_URL="http://localhost:8000"
#
# Production (Vercel multi-service): leave API_PROXY_URL UNSET in the
# Vercel dashboard. The top-level vercel.json routes /api/* to the backend
# service directly (with the /api prefix stripped via a request.path
# transform), so no Next.js rewrite is needed and localhost is never used.
#
# Do NOT set NEXT_PUBLIC_API_URL in Vercel — the browser must stay on the
# same-origin "/api" path to avoid CORS and localhost mistakes.
# NEXT_PUBLIC_API_URL is no longer read by lib/api.ts.
